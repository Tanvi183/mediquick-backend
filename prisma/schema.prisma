// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PHARMACIST
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING
}

enum PrescriptionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum DosageForm {
  TABLET
  SYRUP
  CAPSULE
  INJECTION
  OINTMENT
  DROPS
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String
  role         UserRole    @default(CUSTOMER)
  status       UserStatus  @default(ACTIVE)
  phone        String?
  avatar       String?
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  pharmacyProfile PharmacyProfile?
  prescriptions   Prescription[]   @relation("CustomerPrescriptions")
  reviewedPrescriptions Prescription[] @relation("PharmacistReviews")
  orders          Order[]
  auditLogs       AuditLog[]
  reviews         Review[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

model PharmacyProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  pharmacyName  String
  licenseNumber String   @unique
  address       String
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicines     Medicine[]

  @@map("pharmacy_profiles")
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String?
  imageUrl    String?
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  medicines   Medicine[]

  @@index([slug])
  @@map("categories")
}

model Medicine {
  id                   String     @id @default(uuid())
  pharmacyId           String
  categoryId           String
  name                 String
  genericName          String
  dosageForm           DosageForm @default(TABLET)
  strength             String     // e.g. 500mg, 10ml
  price                Float
  stockQuantity        Int        @default(0)
  requiresPrescription Boolean    @default(false)
  manufacturer         String
  expiryDate           DateTime
  imageUrl             String?
  deletedAt            DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  pharmacy             PharmacyProfile @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  category             Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems           OrderItem[]
  reviews              Review[]

  @@index([name])
  @@index([genericName])
  @@index([categoryId])
  @@index([pharmacyId])
  @@index([price])
  @@map("medicines")
}

model Prescription {
  id                 String             @id @default(uuid())
  customerId         String
  pharmacistId       String?
  fileUrl            String
  notes              String?
  status             PrescriptionStatus @default(PENDING)
  pharmacistFeedback String?
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  customer           User               @relation("CustomerPrescriptions", fields: [customerId], references: [id], onDelete: Cascade)
  pharmacist         User?              @relation("PharmacistReviews", fields: [pharmacistId], references: [id], onDelete: SetNull)
  orders             Order[]

  @@index([customerId])
  @@index([status])
  @@map("prescriptions")
}

model Order {
  id              String      @id @default(uuid())
  customerId      String
  prescriptionId  String?
  totalAmount     Float
  status          OrderStatus @default(PENDING)
  shippingAddress String
  contactPhone    String
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  customer        User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  prescription    Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  orderItems      OrderItem[]
  payment         Payment?

  @@index([customerId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  medicineId String
  quantity   Int
  unitPrice  Float
  subtotal   Float

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([medicineId])
  @@map("order_items")
}

model Payment {
  id                    String        @id @default(uuid())
  orderId               String        @unique
  stripePaymentIntentId String?
  stripeSessionId       String?       @unique
  amount                Float
  currency              String        @default("usd")
  status                PaymentStatus @default(PENDING)
  paymentMethod         String        @default("stripe")
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([stripeSessionId])
  @@index([status])
  @@map("payments")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  resource  String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

model Review {
  id         String   @id @default(uuid())
  customerId String
  medicineId String
  rating     Int      @default(5)
  comment    String?
  createdAt  DateTime @default(now())

  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@index([medicineId])
  @@map("reviews")
}
